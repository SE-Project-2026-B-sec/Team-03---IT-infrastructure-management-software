# Copy to .env (never commit it) or export these in your shell / hosting platform.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Required when NODE_ENV=production
JWT_SECRET=
LICENSE_KEY_SECRET=
AGENT_API_KEY=

# Persistence and backups
DATA_FILE=data/itim.json
BACKUP_DIR=backups
BACKUP_SECRET=

# Optional HTTPS (TLS 1.3 only) and HTTP->HTTPS redirect listener
TLS_CERT_FILE=
TLS_KEY_FILE=
HTTP_REDIRECT_PORT=

# Demo accounts (one per role) are created on first start with this password
SEED_DEMO_USERS=true
DEMO_PASSWORD=ChangeMe!2026

RATE_LIMIT_PER_MINUTE=600
LOG_LEVEL=info
SCHEDULE_JOBS=true
